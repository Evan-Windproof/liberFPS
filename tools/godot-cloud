#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail
tool_dir="${LIBERFPS_TOOL_DIR:-/workspace/.liberfps-tools}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$tool_dir/data}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$tool_dir/config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$tool_dir/cache}"
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
exec "${GODOT_BIN:-$tool_dir/Godot_v4.7.2-stable_linux.x86_64}" "$@"
