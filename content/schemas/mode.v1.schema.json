{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open FPS Sandbox mode v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9_]{0,47}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72,
      "pattern": "^[^\\x00-\\x1F\\x7F]+(?![\\s\\S])"
    },
    "level_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9_]{0,47}(?![\\s\\S])"
    },
    "intermission_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 600
    },
    "repeat_waves": {
      "type": "boolean"
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "enemy_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48,
                  "pattern": "^[a-z][a-z0-9_]{0,47}(?![\\s\\S])"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              },
              "required": [
                "enemy_id",
                "count"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 8
          }
        },
        "required": [
          "groups"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "level_id",
    "intermission_seconds",
    "repeat_waves",
    "waves"
  ],
  "additionalProperties": false
}
