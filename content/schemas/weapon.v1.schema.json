{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open FPS Sandbox weapon v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9_]{0,47}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72,
      "pattern": "^[^\\x00-\\x1F\\x7F]+(?![\\s\\S])"
    },
    "ammo_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9_]{0,47}(?![\\s\\S])"
    },
    "magazine_capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 250
    },
    "rounds_per_minute": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "reload_seconds": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 30
    },
    "firing_mode": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4,
      "enum": [
        "semi",
        "auto"
      ]
    },
    "starting_reserve": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "max_range_m": {
      "type": "number",
      "minimum": 1,
      "maximum": 1000
    },
    "recoil": {
      "type": "object",
      "required": [
        "kick_m",
        "pitch_degrees",
        "recovery_seconds"
      ],
      "properties": {
        "kick_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.15
        },
        "pitch_degrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "recovery_seconds": {
          "type": "number",
          "minimum": 0.025,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "ammo_id",
    "magazine_capacity",
    "rounds_per_minute",
    "reload_seconds"
  ],
  "additionalProperties": false
}
