{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open FPS Sandbox ammo v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9_]{0,47}(?![\\s\\S])"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72,
      "pattern": "^[^\\x00-\\x1F\\x7F]+(?![\\s\\S])"
    },
    "projectile_speed_mps": {
      "type": "number",
      "minimum": 1,
      "maximum": 2000
    },
    "projectile_lifetime_seconds": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 30
    },
    "damage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "projectile_speed_mps",
    "projectile_lifetime_seconds",
    "damage"
  ],
  "additionalProperties": false
}
